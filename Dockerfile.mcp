FROM golang:1.24-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY core/mcp/ core/mcp/
COPY core/cmd/mcp/ core/cmd/mcp/
COPY core/internal/ core/internal/
COPY core/api/ core/api/
COPY core/consts/ core/consts/
COPY core/public/ core/public/
COPY core/data/ core/data/
COPY core/run_dev.go core/main.go ./

# Build dependencies might fail, use simplified approach
WORKDIR /build
COPY . .

RUN go build -o mcp-server ./core/cmd/mcp 2>/dev/null || \
    go build -o mcp-server ./cmd/mcp 2>/dev/null || \
    CGO_ENABLED=0 go build -a -installsuffix cgo -o mcp-server . 2>/dev/null

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /build/mcp-server .
EXPOSE 9090
ENTRYPOINT ["./mcp-server"]